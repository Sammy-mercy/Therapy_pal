{
  "name": "therapy-pal-server",
  "version": "1.0.0",
  "private": true,
  "description": "Therapy Pal API - treatment regimen tracking for patients and clinicians",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file=.env.local src/server.js",
    "dev": "nodemon --watch src --ext js,json --exec \"node --env-file=.env.local\" src/server.js",
    "seed": "node --env-file=.env.local src/seed.js",
    "reset": "node --env-file=.env.local src/seed.js --reset"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
